{
  "title": "Crestron XSIG",
  "config": {
    "step": {
      "user": {
        "title": "Crestron bridge",
        "description": "A bridge is one independent XSIG listener. Crestron connects to Home Assistant on this port. Use a different port for every bridge; 0.0.0.0 listens on all local IPv4 interfaces. Listen address belongs to this Home Assistant machine, not the Crestron processor. A processor does not need to be connected to save configuration.",
        "data": {
          "name": "Name",
          "host": "Listen address",
          "port": "Listen port"
        }
      },
      "reconfigure": {
        "title": "Crestron bridge",
        "description": "A bridge is one independent XSIG listener. Crestron connects to Home Assistant on this port. Use a different port for every bridge; 0.0.0.0 listens on all local IPv4 interfaces. Listen address belongs to this Home Assistant machine, not the Crestron processor. A processor does not need to be connected to save configuration.",
        "data": {
          "name": "Name",
          "host": "Listen address",
          "port": "Listen port"
        }
      }
    },
    "error": {
      "invalid_config": "Enter a name, a literal listen IP address and a port from 1 to 65535.",
